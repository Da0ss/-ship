# Ключ Gemini API (https://aistudio.google.com/apikey). Не коммитьте настоящий .env.
GEMINI_API_KEY=
# Модель Gemini
GEMINI_MODEL=gemini-3.6-flash
# Запасные модели через запятую: агент переключается при 503/404
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# Минимальная пауза между запросами, секунды (лимиты бесплатного тарифа)
GEMINI_MIN_INTERVAL=4
# Таймаут одного запроса к модели, секунды
GEMINI_TIMEOUT=180

# Провайдер LLM: gemini (по умолчанию) или openai
# LLM_PROVIDER=gemini
# OpenAI-совместимый провайдер (LLM_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_FALLBACK_MODELS=
