# Ключ Gemini API (https://aistudio.google.com/apikey). Не коммитьте настоящий .env.
GEMINI_API_KEY=

# Сильная модель: проверка требований, набора, покрытия, банковская проверка, критик.
# На бесплатном тарифе у сильных моделей ~20 запросов в день на проект, прогон тратит ~7.
# Точные идентификаторы моделей для вашего ключа: python -m validator --list-models
GEMINI_MODEL=gemini-4-hydrogen
# Запасные сильные модели через запятую: агент переключается при 404/503
# и когда дневная квота текущей модели закончилась.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash
# Пауза между запросами, секунды (5 запросов в минуту на бесплатном тарифе → 13 с)
GEMINI_MIN_INTERVAL=13
# Таймаут одного запроса к модели, секунды
GEMINI_TIMEOUT=180

# Лёгкие этапы (отбор фрагментов, текст вердикта, чек-лист ревью) на быстрой модели
# с большой квотой (~500 запросов в день). Пусто — все этапы на сильной модели.
VALIDATOR_FAST_MODEL=gemini-3.5-flash-lite
VALIDATOR_FAST_FALLBACKS=gemini-3.1-flash-lite
VALIDATOR_FAST_MIN_INTERVAL=4.5

# Провайдер LLM: gemini (по умолчанию) или openai
# LLM_PROVIDER=gemini
# OpenAI-совместимый провайдер (LLM_PROVIDER=openai): OpenAI, OpenRouter, локальные vLLM/Ollama
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_FALLBACK_MODELS=
